@* Bộ icon nét mảnh tự vẽ (24x24, stroke = currentColor). *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="@(Filled ? "currentColor" : "none")"
     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "home":
            <path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /><path d="M10 21v-6h4v6" />
            break;
        case "cup":
            <path d="M5 8h12v6a6 6 0 0 1-6 6h0a6 6 0 0 1-6-6V8Z" /><path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17" /><path d="M8 2.5c0 1.5 1.5 1.5 1.5 3M12 2.5c0 1.5 1.5 1.5 1.5 3" />
            break;
        case "receipt":
            <path d="M6 2.5h12v19l-3-2-3 2-3-2-3 2v-19Z" /><path d="M9 8h6M9 12h6M9 16h3" />
            break;
        case "gift":
            <rect x="3.5" y="8" width="17" height="4" rx="1" /><path d="M5 12v9h14v-9" /><path d="M12 8v13" /><path d="M12 8c-1.5-3-5.5-4-5.5-1.5S10 8 12 8Zm0 0c1.5-3 5.5-4 5.5-1.5S14 8 12 8Z" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" /><path d="M4 21c1-4 4.5-6 8-6s7 2 8 6" />
            break;
        case "heart":
            <path d="M12 20s-7.5-4.6-9-9.3C2 7.4 4.2 4.5 7.3 4.5c2 0 3.6 1.1 4.7 2.7 1.1-1.6 2.7-2.7 4.7-2.7 3.1 0 5.3 2.9 4.3 6.2C19.5 15.4 12 20 12 20Z" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "minus":
            <path d="M5 12h14" />
            break;
        case "back":
            <path d="M15 5l-7 7 7 7" />
            break;
        case "next":
            <path d="M9 5l7 7-7 7" />
            break;
        case "star":
            <path d="M12 3.2l2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 17l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8L12 3.2Z" />
            break;
        case "bell":
            <path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15L6 16Z" /><path d="M10 20.5a2 2 0 0 0 4 0" />
            break;
        case "store":
            <path d="M4 9.5 5.5 4h13L20 9.5" /><path d="M4 9.5c0 1.4 1.1 2.5 2.7 2.5s2.6-1.1 2.6-2.5c0 1.4 1.1 2.5 2.7 2.5s2.7-1.1 2.7-2.5c0 1.4 1 2.5 2.6 2.5S20 10.9 20 9.5" /><path d="M5.5 12v8.5h13V12" /><path d="M10 20.5v-5h4v5" />
            break;
        case "bag":
            <path d="M5 8h14l-1 13H6L5 8Z" /><path d="M9 10V6.5a3 3 0 0 1 6 0V10" />
            break;
        case "truck":
            <path d="M2.5 6.5h11v10h-11z" /><path d="M13.5 10h4l3 3.5v3h-7" /><circle cx="7" cy="18" r="1.8" /><circle cx="17" cy="18" r="1.8" />
            break;
        case "chat":
            <path d="M4 5h16v11H9l-5 4V5Z" /><path d="M8 9.5h8M8 12.5h5" />
            break;
        case "clipboard":
            <rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4V2.8h6V4" /><path d="M8.5 10l1.5 1.5 3-3M8.5 16h7" />
            break;
        case "ticket":
            <path d="M3 8a2 2 0 0 0 0 4v0a2 2 0 0 0 0 4v2h18v-2a2 2 0 0 1 0-4 2 2 0 0 1 0-4V6H3v2Z" /><path d="M14 6v12" stroke-dasharray="2 2" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" />
            break;
        case "logout":
            <path d="M14 4h5v16h-5" /><path d="M10 8l-4 4 4 4M6 12h10" />
            break;
        case "edit":
            <path d="M4 20h4L19 9l-4-4L4 16v4Z" /><path d="M13.5 6.5l4 4" />
            break;
        case "check":
            <path d="M5 12.5l4.5 4.5L19 7.5" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "pin":
            <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" />
            break;
        case "info":
            <circle cx="12" cy="12" r="8.5" /><path d="M12 11v5M12 8v.01" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" />
            break;
        case "coin":
            <circle cx="12" cy="12" r="8.5" /><path d="M14.5 9.2c-.6-.8-1.5-1.2-2.5-1.2-1.4 0-2.5.8-2.5 2s1.1 1.6 2.5 2 2.5.8 2.5 2-1.1 2-2.5 2c-1 0-2-.4-2.5-1.2M12 6.5V8M12 16v1.5" />
            break;
        default:
            <circle cx="12" cy="12" r="8" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 22;
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Filled { get; set; }
}
