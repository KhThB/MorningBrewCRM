@page
@model TiersModel
@* [CRM-01] Quản lý hạng thành viên *@
@{
    ViewData["Title"]=Model.Title;
    var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    Func<Dictionary<string,JsonElement>,object> actions=@<div class="row-actions">
        @{var min=ReportView.Decimal(item,"min_spent")??0;
          var fill=JsonSerializer.Serialize(new{id=item["tier_id"].ToString(),display_name=item["display_name"].ToString(),name=item["display_name"].ToString(),
              minSpent=min.ToString("0",System.Globalization.CultureInfo.InvariantCulture),benefit=ReportView.Text(item,"benefit"),customers=item["customers"].ToString(),isBase=min==0?"true":"false"});}
        <button type="button" class="btn-sm" data-open="m-edit" data-fill="@fill">Sửa</button>
        <a class="btn-sm" href="/Manager/Customers?tier=@item["code"]">Xem khách</a>
        @if(min>0){<button type="button" class="btn-sm danger-text" data-open="m-delete" data-fill="@fill">Xóa</button>}
    </div>;
}
<div class="topbar"><div><h1>@Model.Title</h1><p class="muted">@Model.Subtitle</p></div></div>
<section class="panel">
    <div class="list-toolbar"><div></div><button type="button" class="primary add-btn" data-open="m-add">+ Thêm hạng</button></div>
    <p class="list-count">Khách đạt hạng cao nhất có mức ≤ chi tiêu 12 tháng của mình (đơn hoàn tất, đã trừ tiền hoàn). Hạng 0đ là hạng mặc định, không xóa được.</p>
    <partial name="_Table" model="@(new TableView{Rows=Model.Rows,Actions=actions,Hide=new HashSet<string>{"tier_id","code"},
        Format=(k,r)=>k=="min_spent"?(ReportView.Decimal(r,k)??0).ToString("#,0",vi)+"đ":null})" />
    <p class="muted">Gợi ý: tặng voucher theo hạng ở Ưu đãi → Cấp voucher → Theo nhóm khách → Hạng thành viên.</p>
</section>
@foreach(var (id,op,title,button) in new[]{("m-add","tier","Thêm hạng","Thêm hạng"),("m-edit","tier-update","Sửa hạng","Lưu thay đổi")})
{
<dialog class="modal" id="@id"><form method="post">
    <input type="hidden" name="operation" value="@op"><input type="hidden" name="modal" value="@id">@if(op=="tier-update"){<input type="hidden" name="id">}
    <header><h2>@title</h2><button type="button" class="modal-x" data-close aria-label="Đóng">×</button></header>
    <div class="modal-body">
        <div class="two"><div><label>Tên hạng *</label><input name="name" minlength="2" maxlength="50" required placeholder="VD: Bạch kim"></div>
            <div><label>Chi tiêu 12 tháng tối thiểu (đ) *</label><input name="minSpent" type="number" min="0" step="1" required></div></div>
        <label>Quyền lợi (hiển thị trên thẻ thành viên trong app)</label><input name="benefit" maxlength="300">
        @if(op=="tier-update"){<p class="muted" data-show-if="isBase=true">Hạng mặc định luôn có mức 0đ.</p>}
    </div>
    <footer><button type="button" class="secondary" data-close>Hủy</button><button class="primary">@button</button></footer>
</form></dialog>
}
<dialog class="modal" id="m-delete"><form method="post">
    <input type="hidden" name="operation" value="tier-delete"><input type="hidden" name="modal" value="m-delete"><input type="hidden" name="id">
    <header><h2>Xóa hạng</h2><button type="button" class="modal-x" data-close aria-label="Đóng">×</button></header>
    <div class="modal-body"><p>Xóa hạng <b data-text="display_name"></b>? <b data-text="customers"></b> khách đang ở hạng này sẽ chuyển xuống hạng thấp hơn liền kề.</p></div>
    <footer><button type="button" class="secondary" data-close>Hủy</button><button class="danger">Xóa hạng</button></footer>
</form></dialog>
