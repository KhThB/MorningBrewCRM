@page
@model SurveysModel
@{ViewData["Title"]=Model.Title;}
<div class="topbar"><div><h1>@Model.Title</h1><p class="muted">@Model.Subtitle</p></div></div>
@if(Model.SurveyId.HasValue)
{
    @if(Model.Summary is not null){<partial name="_SurveySummary" model="Model.Summary" />}
    <section class="panel"><h2>Câu trả lời chi tiết</h2><partial name="_Rows" model="Model.Rows" />
    <div class="flow">@if(!string.IsNullOrEmpty(Model.NextPageToken)){<a asp-route-surveyId="@Model.SurveyId" asp-route-pageToken="@Model.NextPageToken">Trang tiếp →</a>}</div></section>
    <a asp-page="/Manager/Surveys" asp-route-surveyId="">Về danh sách khảo sát</a>
}
else
{
<section class="panel"><h2>Danh sách</h2><partial name="_Rows" model="Model.Rows" /><partial name="_Pager" model="Model" /></section>
<section class="panel"><h2>Tạo khảo sát</h2><form method="post" id="survey-form"><input type="hidden" name="operation" value="survey">
<div class="grid-2"><div><label>Tiêu đề</label><input name="title" maxlength="250" required></div><div><label>Mô tả</label><input name="description" maxlength="2000"></div></div>
<h3>Câu hỏi</h3><p class="muted">Loại <b>Đánh giá</b> cho điểm 1–5. Loại <b>Chọn một / Chọn nhiều</b> cần ít nhất 2 lựa chọn, mỗi dòng một lựa chọn (dùng để thăm dò khi ra mắt sản phẩm mới). Câu để trống nội dung sẽ bị bỏ qua.</p>
<div id="questions">
<div class="question-row">
<div><label>Nội dung câu hỏi</label><input name="q_text" maxlength="2000"></div>
<div><label>Loại</label><select name="q_type" class="q-type"><option value="Rating">Đánh giá 1–5</option><option value="SingleChoice">Chọn một</option><option value="MultipleChoice">Chọn nhiều</option><option value="Text">Tự luận</option></select></div>
<div><label>Bắt buộc</label><select name="q_required"><option value="true">Có</option><option value="false">Không</option></select></div>
<div class="q-options hidden"><label>Lựa chọn (mỗi dòng một lựa chọn)</label><textarea name="q_options" rows="3"></textarea></div>
<button type="button" class="secondary q-remove" aria-label="Xóa câu hỏi">Xóa</button>
</div>
</div>
<button type="button" class="secondary" id="add-question">+ Thêm câu hỏi</button>
<partial name="_Scope" model="Model" /><button class="primary">Tạo bản nháp</button></form></section>
<div class="grid-2">
<section class="panel"><h2>Quản lý khảo sát</h2><form method="post"><label>Khảo sát</label><select name="id">@foreach(var x in Model.Rows){<option value="@x["survey_id"]">@x["title"] · @RowDisplay.Value("status",x["status"])</option>}</select>
<button class="primary" name="operation" value="publish">Phát hành</button> <button class="secondary" name="operation" value="close">Đóng</button> <button class="secondary" name="operation" value="results">Xem kết quả</button></form>
<h3>Mời một khách hàng</h3><form method="post"><input type="hidden" name="operation" value="invite"><label>Khảo sát đang mở</label><select name="id">@foreach(var x in Model.Rows.Where(x=>x["status"].ToString()=="Open")){<option value="@x["survey_id"]">@x["title"]</option>}</select>
<label>Khách hàng</label><select name="customerId">@foreach(var x in Model.Choices("customers")){<option value="@x["id"]">@x["display_name"]</option>}</select><button class="primary">Gửi lời mời</button></form></section>
<section class="panel"><h2>Mời hàng loạt</h2><form method="post" id="bulk-form"><input type="hidden" name="operation" value="invite-bulk">
<label>Khảo sát đang mở</label><select name="id" required>@foreach(var x in Model.Rows.Where(x=>x["status"].ToString()=="Open")){<option value="@x["survey_id"]">@x["title"]</option>}</select>
<label>Cách chọn khách</label><select name="mode" id="bulk-mode"><option value="segment">Theo nhóm khách</option><option value="all">Tất cả khách đang hoạt động</option><option value="list">Chọn từng khách</option></select>
<div class="bulk-segment"><label>Nhóm tuổi</label><select name="ageGroup"><option value="">Mọi nhóm tuổi</option>@foreach(var a in SurveysModel.AgeGroups){<option value="@a.Id">@a.Name</option>}</select>
<label>Giới tính</label><select name="gender"><option value="">Mọi giới tính</option><option value="Male">Nam</option><option value="Female">Nữ</option><option value="Other">Khác</option><option value="Undisclosed">Chưa cung cấp</option></select>
<label>Thích sản phẩm</label><select name="productId"><option value="">Không lọc theo sở thích</option>@foreach(var p in Model.Choices("products")){<option value="@p["id"]">@p["display_name"]</option>}</select></div>
<div class="bulk-list hidden"><label>Khách hàng (tối đa 200 khách gần nhất)</label><div class="check-list">@foreach(var x in Model.Choices("customers")){<label><input type="checkbox" name="customerIds" value="@x["id"]"> @x["display_name"]</label>}</div></div>
<button class="primary">Gửi lời mời</button></form><p class="muted">Khách đã được mời trước đó sẽ được bỏ qua, không gửi trùng.</p></section>
</div>
<script>
(()=>{const box=document.getElementById('questions'),tpl=box.firstElementChild.cloneNode(true);
 const sync=row=>row.querySelector('.q-options').classList.toggle('hidden',!/Choice/.test(row.querySelector('.q-type').value));
 box.addEventListener('change',e=>{if(e.target.classList.contains('q-type'))sync(e.target.closest('.question-row'))});
 box.addEventListener('click',e=>{if(e.target.classList.contains('q-remove')&&box.children.length>1)e.target.closest('.question-row').remove()});
 document.getElementById('add-question').onclick=()=>{const r=tpl.cloneNode(true);r.querySelectorAll('input,textarea').forEach(x=>x.value='');box.append(r);sync(r)};
 document.getElementById('survey-form').addEventListener('submit',e=>{for(const r of box.children){const t=r.querySelector('[name=q_text]').value.trim();
  if(t&&/Choice/.test(r.querySelector('.q-type').value)&&r.querySelector('textarea').value.split('\n').filter(x=>x.trim()).length<2){e.preventDefault();alert('Câu "'+t+'" cần ít nhất 2 lựa chọn.');return}}
  if(![...box.querySelectorAll('[name=q_text]')].some(x=>x.value.trim())){e.preventDefault();alert('Cần ít nhất một câu hỏi.')}});
 const mode=document.getElementById('bulk-mode'),seg=document.querySelector('.bulk-segment'),list=document.querySelector('.bulk-list');
 mode.onchange=()=>{seg.classList.toggle('hidden',mode.value!=='segment');list.classList.toggle('hidden',mode.value!=='list')};})();
</script>
}
