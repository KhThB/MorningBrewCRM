@model TableView
@* [UI-02][UI-03][UI-05] Bảng danh sách dùng chung: nhãn trạng thái, cột Thao tác, bấm dòng mở ngăn chi tiết. *@
@if(Model.Rows.Count==0)
{<div class="empty-state">@Model.EmptyText</div>}
else
{
var columns=Model.Rows[0].Keys.Where(k=>k is not ("name" or "etag") && !Model.Hide.Contains(k)).ToList();
<div class="table-wrap"><table class="data-table"><thead><tr>@foreach(var c in columns){<th>@RowDisplay.Label(c)</th>}@if(Model.Actions is not null){<th class="actions-col">Thao tác</th>}</tr></thead><tbody>
@foreach(var row in Model.Rows)
{
var detail=Model.DetailUrl?.Invoke(row);
string? inline=null;
if(detail is null && Model.RowDetail)
{
    var pairs=row.Where(x=>x.Key is not ("name" or "etag")).Select(x=>new[]{RowDisplay.Label(x.Key),TableView.BadgeClass(x.Key,x.Value) is null?(Model.Format?.Invoke(x.Key,row)??RowDisplay.Value(x.Key,x.Value)):Model.Badge(x.Key,x.Value)}).ToList();
    if(Model.ExtraDetail is not null) pairs.AddRange(Model.ExtraDetail(row).Select(x=>new[]{x.Label,x.Value}));
    inline=JsonSerializer.Serialize(pairs);
}
<tr data-detail-url="@detail" data-detail-rows="@inline" data-detail-title="@Model.DetailTitle" class="@(detail is null && inline is null?null:"clickable")">
@foreach(var c in columns)
{
var v=row[c]; var badge=TableView.BadgeClass(c,v);
<td>@if(badge is not null){<span class="badge @badge">@Model.Badge(c,v)</span>}else{@(Model.Format?.Invoke(c,row)??RowDisplay.Value(c,v))}</td>
}
@if(Model.Actions is not null){<td class="actions-col">@Model.Actions(row)</td>}
</tr>
}
</tbody></table></div>
}
