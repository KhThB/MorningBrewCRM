@model List<Dictionary<string,JsonElement>>
@if(Model.Count==0)
{<div class="empty-state">Chưa có dữ liệu trong phạm vi này.</div>}
else
{
<div class="table-wrap"><table><thead><tr>@foreach(var column in Model[0].Keys){<th>@RowDisplay.Label(column)</th>}</tr></thead><tbody>
@foreach(var row in Model){<tr>@foreach(var cell in row){<td>@RowDisplay.Value(cell.Key,cell.Value)</td>}</tr>}
</tbody></table></div>
}
