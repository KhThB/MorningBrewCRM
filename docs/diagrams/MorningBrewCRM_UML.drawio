"geometry"/></mxCell><mxCell id="ec1" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.2;endArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Liberation Sans;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_O" target="n_M"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ec2" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.2;endArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Liberation Sans;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_M" target="n_T"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="323.3" y="209.0"/><mxPoint x="105.0" y="209.0"/></Array></mxGeometry></mxCell><mxCell id="ec3" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.2;endArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Liberation Sans;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_M" target="n_B"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ec4" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.2;endArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Liberation Sans;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_M" target="n_G"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="323.3" y="209.0"/><mxPoint x="541.6" y="209.0"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="bfd1" name="Sơ đồ chức năng (BFD) – phần 1"><mxGraphModel dx="1099" dy="259" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n_R" value="HỆ THỐNG QUẢN LÝ MORNING BREW COFFEE KẾT HỢP CRM" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontStyle=1;fontFamily=Liberation Sans;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="315.2" y="30.0" width="392.0" height="37.0" as="geometry"/></mxCell><mxCell id="n_N0" value="1. Tài khoản &amp; phân quyền" style="swimlane;shape=swimlane;html=1;startSize=29;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#333333;rounded=1;arcSize=4;whiteSpace=wrap;fontFamily=Liberation Sans;fontSize=12;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="113.0" width="219.7" height="116.0" as="geometry"/></mxCell><mxCell id="c1" value="• Đăng nhập / đăng xuất&lt;br&gt;• Thêm, sửa, khóa, xóa tài khoản&lt;br&gt;• Đổi vai trò, ma trận quyền&lt;br&gt;• Xem nhật ký hệ thống&lt;br&gt;• Admin server / Quản lý CRM tách riêng" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Liberation Sans;fontSize=11;fontColor=#000000;" vertex="1" connectable="0" parent="n_N0"><mxGeometry y="29" width="219.7" height="87.0" as="geometry"/></mxCell><mxCell id="n_N1" value="2. Sản phẩm &amp; thực đơn" style="swimlane;shape=swimlane;html=1;startSize=29;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#333333;rounded=1;arcSize=4;whiteSpace=wrap;fontFamily=Liberation Sans;fontSize=12;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="273.7" y="113.0" width="170.0" height="116.0" as="geometry"/></mxCell><mxCell id="c2" value="• Danh mục món&lt;br&gt;• Sản phẩm, size, giá, ảnh&lt;br&gt;• Tùy chọn Đá / Nóng&lt;br&gt;• Báo tạm hết / ngừng bán&lt;br&gt;• Nhà cung cấp" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Liberation Sans;fontSize=11;fontColor=#000000;" vertex="1" connectable="0" parent="n_N1"><mxGeometry y="29" width="170.0" height="87.0" as="geometry"/></mxCell><mxCell id="n_N2" value="3. Khách hàng" style="swimlane;shape=swimlane;html=1;startSize=29;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#333333;rounded=1;arcSize=4;whiteSpace=wrap;fontFamily=Liberation Sans;fontSize=12;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="578.7" y="113.0" width="170.0" height="116.0" as="geometry"/></mxCell><mxCell id="c3" value="• Đăng ký (bắt buộc SĐT)&lt;br&gt;• Hồ sơ, món yêu thích&lt;br&gt;• Sổ địa chỉ giao hàng&lt;br&gt;• Tra cứu, xem chi tiết 360°&lt;br&gt;• Khóa / xóa khách hàng" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Liberation Sans;fontSize=11;fontColor=#000000;" vertex="1" connectable="0" parent="n_N2"><mxGeometry y="29" width="170.0" height="87.0" as="geometry"/></mxCell><mxCell id="n_N3" value="4. Đặt hàng &amp; thanh toán" style="swimlane;shape=swimlane;html=1;startSize=29;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#333333;rounded=1;arcSize=4;whiteSpace=wrap;fontFamily=Liberation Sans;fontSize=12;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="883.7" y="113.0" width="184.8" height="116.0" as="geometry"/></mxCell><mxCell id="c4" value="• Chọn hình thức nhận hàng&lt;br&gt;• Thực đơn, giỏ hàng, voucher&lt;br&gt;• Đặt đơn App / lập đơn POS&lt;br&gt;• Thanh toán mô phỏng / tiền mặt&lt;br&gt;• Tự hủy đơn quá hạn 15 phút" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Liberation Sans;fontSize=11;fontColor=#000000;" vertex="1" connectable="0" parent="n_N3"><mxGeometry y="29" width="184.8" height="87.0" as="geometry"/></mxCell><mxCell id="ec5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;stroke