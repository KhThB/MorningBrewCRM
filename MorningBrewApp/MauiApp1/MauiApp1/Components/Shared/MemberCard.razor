@* Thẻ thành viên Morning Brew: điểm + hạng thành viên.
   [CRM-01] Hạng lấy từ database (Quản lý CRM → Hạng thành viên), tính theo chi tiêu 12 tháng gần nhất –
   trước đây app tự suy ra hạng từ điểm nên web và app không khớp nhau. *@
<div class="member-card">
    <div class="member-top">
        <div>
            <span class="eyebrow">MORNING BREW CARD</span>
            <strong class="member-name">@Profile?.FullName</strong>
        </div>
        <span class="tier">@(Profile?.TierName ?? "Thành viên")</span>
    </div>
    <div class="member-points">
        <Icon Name="coin" Size="22" />
        <b>@((Profile?.LoyaltyPoints ?? 0).ToString("#,0"))</b><span>điểm</span>
    </div>
    @if (Profile?.NextTierSpent is decimal next && next > 0)
    {
        var percent = (int)Math.Clamp(Profile.SpentLastYear * 100 / next, 0, 100);
        <div class="progress" aria-label="Tiến độ lên hạng"><i style="width:@(percent)%"></i></div>
        <small>Chi tiêu 12 tháng @Fmt.Money(Profile.SpentLastYear) · còn @Fmt.Money(next - Profile.SpentLastYear) để lên hạng @Profile.NextTierName</small>
    }
    else if (Profile is not null)
    {
        <small>Bạn đang ở hạng cao nhất</small>
    }
    @if (!string.IsNullOrEmpty(Profile?.TierBenefit))
    {
        <small class="tier-benefit">@Profile.TierBenefit</small>
    }
</div>

@code {
    [Parameter] public Profile? Profile { get; set; }
}
