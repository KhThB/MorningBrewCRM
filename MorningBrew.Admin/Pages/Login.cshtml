@page
@model LoginModel
@{ Layout=null; }
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Đăng nhập · Morning Brew</title><link rel="stylesheet" href="/css/site.css"></head>
<body class="login-bg"><main class="login-card">
<div class="brand big">Morning<span>Brew</span></div><h1>Chào mừng trở lại</h1><p class="muted">Đăng nhập bằng tài khoản Morning Brew của bạn.</p>
<div asp-validation-summary="All" class="alert"></div>
<form method="post"><label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="username" required>
<label asp-for="Password">Mật khẩu</label><input asp-for="Password" type="password" autocomplete="current-password" required>
<button class="primary full">Đăng nhập</button></form></main></body></html>
