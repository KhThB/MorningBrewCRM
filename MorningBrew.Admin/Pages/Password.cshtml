@page
@model PasswordModel
@* [WEB-05] Tự đổi mật khẩu trên web (cả Admin server và Quản lý CRM). Trước đây chỉ đổi được trong app. *@
@{
    ViewData["Title"]="Đổi mật khẩu";
    Layout=Portals.Of(HttpContext)==Portals.Admin?"_AdminLayout":"_ManagerLayout";
}
<div class="topbar"><div><h1>Đổi mật khẩu</h1><p class="muted">Tài khoản @User.Identity?.Name. Mật khẩu mới dùng cho cả web, app và POS.</p></div></div>
<section class="panel narrow-panel">
    @if(Model.Error is not null){<div class="modal-error" role="alert">@Model.Error</div>}
    <form method="post" autocomplete="off">
        <label for="current">Mật khẩu hiện tại *</label><input id="current" name="current" type="password" required maxlength="200" autocomplete="current-password">
        <label for="next">Mật khẩu mới * (ít nhất 10 ký tự, khác mật khẩu hiện tại)</label><input id="next" name="next" type="password" required minlength="10" maxlength="200" autocomplete="new-password">
        <label for="confirm">Nhập lại mật khẩu mới *</label><input id="confirm" name="confirm" type="password" required minlength="10" maxlength="200" autocomplete="new-password">
        <p class="muted">Các phiên đăng nhập khác của tài khoản (giao diện còn lại, app, POS) sẽ bị đăng xuất; phiên đang dùng ở đây vẫn giữ.</p>
        <div class="row-actions"><button class="primary">Đổi mật khẩu</button><a class="btn-sm" href="@((Portals.Of(HttpContext)??Portals.Manager).Home)">Hủy</a></div>
    </form>
</section>
