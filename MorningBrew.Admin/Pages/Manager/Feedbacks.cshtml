@page
@model FeedbacksModel
@{ViewData["Title"]=Model.Title;}
<div class="topbar"><div><h1>@Model.Title</h1><p class="muted">@Model.Subtitle</p></div></div>
<section class="panel"><form method="get" class="filter-row">
<div><label>Tìm theo nội dung hoặc tên khách</label><input name="q" value="@Model.Q"></div>
<div><label>Trạng thái</label><select name="status"><option value="">Tất cả</option><option value="New" selected="@(Model.Status=="New")">Mới</option><option value="Processing" selected="@(Model.Status=="Processing")">Đang xử lý</option><option value="Resolved" selected="@(Model.Status=="Resolved")">Đã giải quyết</option></select></div>
<div><button class="primary">Lọc</button></div></form></section>
<section class="panel"><h2>Danh sách</h2><partial name="_Rows" model="Model.Rows" /><partial name="_Pager" model="Model" /></section>
<section class="panel"><h2>Trả lời phản hồi</h2><form method="post"><input type="hidden" name="operation" value="feedback">
<label>Phản hồi chưa giải quyết (trong danh sách đang lọc)</label><select name="id">@foreach(var x in Model.Rows.Where(x=>x["status"].ToString()!="Resolved")){<option value="@x["feedback_id"]">#@x["feedback_id"] · @x["full_name"] · @x["content"]</option>}</select>
<label>Trạng thái</label><select name="status"><option value="Processing">Đang xử lý</option><option value="Resolved">Đã giải quyết</option></select>
<label>Nội dung trả lời</label><textarea name="response" maxlength="4000" required></textarea><button class="primary">Gửi trả lời</button></form></section>
