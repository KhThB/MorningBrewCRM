@page "/login"
@layout BlankLayout
@inject PosAuth Auth
@inject NavigationManager Nav
@* [BUG-02 · giai đoạn 2] Đăng nhập POS (thu ngân, quản lý, chủ cửa hàng). *@
<div class="auth">
    <div class="auth-hero small"><div class="logo-word">Morning<span>Brew</span> POS</div><p>Máy bán hàng tại quầy</p></div>
    <form class="auth-card" @onsubmit="Submit" @onsubmit:preventDefault>
        <h1>Đăng nhập nhân viên</h1>
        @if (error is not null) { <div class="alert" role="alert">@error</div> }
        <label for="email">Email</label>
        <input id="email" class="input" type="email" @bind="email" autocomplete="username" required />
        <label for="password">Mật khẩu</label>
        <input id="password" class="input" type="password" @bind="password" autocomplete="current-password" required />
        <button class="btn btn-primary block" type="submit" disabled="@busy">@(busy ? "Đang đăng nhập..." : "Đăng nhập")</button>
    </form>
</div>
@code {
    private string email = "", password = "";
    private string? error;
    private bool busy;
    private async Task Submit()
    {
        busy = true; error = null;
        try { await Auth.LoginAsync(email, password); Nav.NavigateTo("/", replace: true, forceLoad: false); }
        catch (ApiException e) { error = e.Message; }
        busy = false;
    }
}
