@page "/feedback/new"
@inject CrmService Crm
@inject ShopService Shop
@inject ToastService Toasts
@inject NavigationManager Nav

<PageHeader Title="@(order is null ? "Gửi phản hồi" : "Đánh giá đơn hàng")" />

<div class="page-body with-footer">
    @if (order is not null)
    {
        <div class="card">
            <div class="row-between"><b>@order.OrderCode</b><span class="muted small">@Fmt.When(order.CreatedAt)</span></div>
            <p class="muted small">@order.BranchName</p>
        </div>
    }

    <div class="card form">
        <label>Bạn muốn góp ý về</label>
        <div class="chips wrap">
            @foreach (var t in new[] { "Product", "Service", "Space", "Other" })
            {
                <button type="button" class="chip-btn @(type == t ? "active" : "")" @onclick="() => type = t">@Fmt.FeedbackType(t)</button>
            }
        </div>

        @if (type == "Product")
        {
            <label for="product">Sản phẩm</label>
            <select id="product" class="input" @bind="productId">
                <option value="0">— Chọn sản phẩm —</option>
                @foreach (var p in products)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
        }

        <label>Mức độ hài lòng</label>
        <StarRating @bind-Value="rating" />
        @if (rating is null) { <small class="muted block">Chưa chấm – có thể bỏ trống nếu bạn không muốn đánh giá sao.</small> } @* [BUG-10] *@

        <label for="content">Nội dung *</label>
        <textarea id="content" class="input" rows="5" maxlength="4000" @bind="content" @bind:event="oninput"
                  placeholder="Chia sẻ trải nghiệm của bạn: hương vị, nhiệt độ, thái độ phục vụ..."></textarea>
        @* [APP-07] Báo lỗi tiếng Việt ngay trên form thay cho lỗi kỹ thuật từ máy chủ *@
        @if (touched && ContentError is { } msg) { <small class="req block">@msg</small> }
        <small class="muted right">@content.Length/4000</small>
    </div>
</div>

<div class="footer-bar">
    <button class="btn btn-primary block" @onclick="Send" disabled="@busy"> @* [APP-07] luôn bấm được để hiện lý do khi nội dung chưa hợp lệ *@
        @(busy ? "Đang gửi..." : "Gửi phản hồi")
    </button>
</div>

@code {
    [SupplyParameterFromQuery] public int? OrderId { get; set; }
    [SupplyParameterFromQuery] public int? ProductId { get; set; }

    private Order? order;
    private List<(int Id, string Name)> products = [];
    private string type = "Product";
    private int productId;
    private int? rating; // [BUG-10] trước đây mặc định 5 sao → khách không chạm vẫn gửi 5 sao
    private string content = "";
    private bool busy;
    private bool touched; // [APP-07]
    private const int MinContent = 10; // [APP-07] tối thiểu 10 ký tự để phản hồi có nội dung
    private string? ContentError => content.Trim().Length switch
    {
        0 => "Vui lòng nhập nội dung phản hồi.",
        < MinContent => $"Nội dung quá ngắn, vui lòng viết ít nhất {MinContent} ký tự.",
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var menu = await Shop.GetMenuAsync();
            if (OrderId is not null)
            {
                order = await Shop.GetOrderAsync(OrderId.Value);
                products = order?.Lines.GroupBy(l => l.ProductId).Select(g => (Id: g.Key, Name: g.First().Name)).ToList() ?? new();
            }
            if (products.Count == 0)
                products = menu.Items.GroupBy(x => x.ProductId).Select(g => (Id: g.Key, Name: g.First().Name)).ToList();
        }
        catch (ApiException e) { Toasts.Error(e); }
        productId = ProductId ?? products.FirstOrDefault().Id;
    }

    private async Task Send()
    {
        touched = true; // [APP-07]
        if (ContentError is { } err) { Toasts.Show(err, true); return; }
        if (type == "Product" && productId == 0) { Toasts.Show("Vui lòng chọn sản phẩm.", true); return; }
        busy = true;
        try
        {
            // [CLEAN-02] Bỏ lọc ID món/đơn mẫu và lời gọi MarkFeedbackSent rỗng (không còn dữ liệu mẫu).
            int? product = type == "Product" && productId > 0 ? productId : null;
            await Crm.SendFeedbackAsync(type, rating, content, product, order?.BranchId ?? Shop.CurrentBranch.BranchId, order?.OrderId);
            Toasts.Show("Cảm ơn bạn! Phản hồi đã được gửi tới Morning Brew.");
            Nav.NavigateTo("/account/feedbacks", replace: true);
        }
        catch (ApiException e) { Toasts.Error(e); }
        busy = false;
    }
}
