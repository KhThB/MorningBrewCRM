@page "/cart"
@* [BUG-02] Giỏ hàng + thanh toán: nhận tại quầy / giao hàng, trả trước (cổng mô phỏng) / tiền mặt khi nhận.
   Trước đây chỉ tạo đơn mô phỏng trong bộ nhớ app. *@
@inject ShopService Shop
@inject CrmService Crm
@inject ToastService Toasts
@inject NavigationManager Nav

<PageHeader Title="Giỏ hàng" />

<div class="page-body with-footer">
    <StateView Empty="Shop.Cart.Count == 0" EmptyText="Giỏ hàng đang trống." EmptyIcon="bag">
        <EmptyAction><a class="btn btn-primary" href="/menu">Xem thực đơn</a></EmptyAction>
        <ChildContent>
            <div class="card list">
                @foreach (var line in Shop.Cart)
                {
                    <div class="cart-line">
                        <ProductThumb Category="@line.Item.Category" ProductName="@line.Item.Name" ImageUrl="@line.Item.ImageUrl" />
                        <div class="grow"><b>@line.Item.Name</b><small class="muted">@("Size " + line.Item.VariantName + (line.Picked.Count > 0 ? " · " + line.OptionText : ""))</small><span class="price">@Fmt.Money(line.Total)</span></div>
                        <div class="stepper sm">
                            <button @onclick="() => Shop.ChangeQuantity(line.Key, -1)" aria-label="Giảm"><Icon Name="minus" Size="16" /></button>
                            <b>@line.Quantity</b>
                            <button @onclick="() => Shop.ChangeQuantity(line.Key, 1)" aria-label="Tăng"><Icon Name="plus" Size="16" /></button>
                        </div>
                    </div>
                }
            </div>

            <div class="card form">
                @* [UI2-A2b] Hình thức nhận đã chọn ở trang chủ / khi mở Thực đơn → giỏ chỉ hiển thị, không hỏi lại *@
                <div class="row-between"><label>Hình thức nhận hàng</label>
                    @* [APP-15] Bấm vào hình thức để đổi ở trang /order-type, xong quay lại giỏ *@
                    <a class="chip @(fulfillment == "Delivery" ? "chip-info" : "chip-ok")" href="/order-type?next=/cart"><Icon Name="@(fulfillment == "Delivery" ? "truck" : "bag")" Size="14" /> @(fulfillment == "Delivery" ? $"Giao hàng (+{Fmt.Money(Shop.CurrentBranch.DeliveryFee)})" : "Nhận tại quầy") · Đổi</a></div>
                @if (fulfillment == "Pickup")
                {
                    <p class="muted small"><Icon Name="store" Size="16" /> @Shop.CurrentBranch.Name · @Shop.CurrentBranch.Address</p>
                }
                else
                {
                    @* [APP-05] Chọn địa chỉ đã lưu (tự điền địa chỉ mặc định) thay vì gõ lại mỗi lần *@
                    @if (addresses.Count > 0)
                    {
                        <label for="saved">Địa chỉ đã lưu</label>
                        <select id="saved" class="input" value="@(addressId?.ToString() ?? "")" @onchange="PickAddress">
                            @foreach (var a in addresses)
                            {
                                <option value="@a.AddressId">@($"{a.Label} · {a.AddressText}")</option>
                            }
                            <option value="">+ Nhập địa chỉ mới</option>
                        </select>
                    }
                    <label for="name">Người nhận *</label>
                    <input id="name" class="input" @bind="contactName" maxlength="120" />
                    <label for="phone">Số điện thoại *</label>
                    <input id="phone" class="input" type="tel" @bind="contactPhone" maxlength="20" />
                    <label for="address">Địa chỉ giao *</label>
                    <textarea id="address" class="input" rows="2" @bind="address" @bind:event="oninput" maxlength="500"></textarea> @* [APP-05] cập nhật khi gõ để hiện ô "Lưu địa chỉ" ngay *@
                    <label for="dnote">Ghi chú cho người giao</label>
                    <input id="dnote" class="input" @bind="deliveryNote" maxlength="300" />
                    @if (IsNewAddress)
                    {
                        <label class="check"><input type="checkbox" @bind="saveAddress" /> Lưu địa chỉ này cho lần sau</label> @* [APP-05] *@
                    }
                }
                @* [UI2-A1] Một ô chọn xổ xuống: Tiền mặt / Chuyển khoản (Chuyển khoản = trả trước qua cổng thanh toán mô phỏng) *@
                <label for="pay">Phương thức thanh toán</label>
                <select id="pay" class="input" @bind="paymentMode">
                    <option value="COD">Tiền mặt (trả khi nhận hàng)</option>
                    <option value="Prepaid">Chuyển khoản (thanh toán ngay)</option>
                </select>
                @if (paymentMode == "Prepaid") { <p class="muted small">Sau khi đặt, bạn thanh toán trong 15 phút ở trang chi tiết đơn (cổng mô phỏng, không trừ tiền thật).</p> }
                <label for="note">Ghi chú cho quán</label>
                <input id="note" class="input" @bind="note" maxlength="500" placeholder="Ví dụ: ít ngọt, lấy lúc 9h" />
            </div>

            <div class="card">
                <div class="row-between"><b><Icon Name="ticket" Size="18" /> Voucher</b>
                    @if (vouchers.Count == 0) { <span class="muted small">Không có voucher khả dụng</span> }
                </div>
                @if (vouchers.Count > 0)
                {
                    <select class="input" value="@(Shop.VoucherId?.ToString() ?? "")" @onchange="PickVoucher" aria-label="Chọn voucher">
                        <option value="">Không dùng voucher</option>
                        @foreach (var v in vouchers)
                        {
                            @* [APP-01] Ghi rõ mức tối đa và đơn tối thiểu của voucher *@
                            <option value="@v.CustomerPromotionId">@v.Name · @Fmt.Discount(v.DiscountType, v.DiscountValue, v.MaxDiscount)@(v.MinSubtotal > 0 ? $" · đơn từ {Fmt.Money(v.MinSubtotal)}" : "")</option>
                        }
                    </select>
                    @if (Shop.VoucherBelowMinimum)
                    {
                        <p class="alert small">Đơn cần từ @Fmt.Money(Shop.SelectedVoucher!.MinSubtotal) để dùng voucher này (còn thiếu @Fmt.Money(Shop.SelectedVoucher.MinSubtotal - Shop.CartSubtotal)).</p>
                    }
                }
            </div>

            <div class="card summary">
                <div class="row-between"><span>Tạm tính</span><span>@Fmt.Money(Shop.CartSubtotal)</span></div>
                <div class="row-between"><span>Giảm giá</span><span>-@Fmt.Money(Discount)</span></div>
                @if (fulfillment == "Delivery") { <div class="row-between"><span>Phí giao hàng</span><span>@Fmt.Money(Fee)</span></div> }
                <div class="row-between total"><b>Tổng cộng</b><b>@Fmt.Money(Total)</b></div>
                <p class="muted small">Số tiền cuối cùng do cửa hàng tính khi tạo đơn. Hoàn tất đơn được tích điểm.</p>
            </div>
        </ChildContent>
    </StateView>
</div>

@if (Shop.Cart.Count > 0)
{
    <div class="footer-bar">
        <button class="btn btn-primary block" @onclick="Place" disabled="@busy">
            @(busy ? "Đang đặt hàng..." : $"Đặt hàng · {Fmt.Money(Total)}")
        </button>
    </div>
}

@code {
    private List<Voucher> vouchers = [];
    private bool busy;
    // Mỗi lần mở giỏ tạo 1 khóa yêu cầu: bấm 2 lần không tạo 2 đơn.
    private Guid requestKey = Guid.NewGuid();
    private string fulfillment = "Pickup", paymentMode = "COD"; // [UI2-A1] mặc định Tiền mặt
    private string? contactName, contactPhone, address, deliveryNote, note;
    private List<CustomerAddress> addresses = []; // [APP-05]
    private int? addressId;                        // [APP-05] địa chỉ đã lưu đang chọn (null = nhập mới)
    private bool saveAddress = true;               // [APP-05]
    // [APP-05] Địa chỉ đang nhập chưa có trong sổ (khác người nhận / SĐT / địa chỉ) → cho phép lưu.
    private bool IsNewAddress => !string.IsNullOrWhiteSpace(address) && !addresses.Any(a =>
        a.AddressText.Trim() == address.Trim() && a.RecipientName.Trim() == contactName?.Trim() && a.Phone == PhoneRule.Normalize(contactPhone));

    private decimal Discount => Shop.VoucherDiscount; // [APP-01] tính lại theo tạm tính, đã áp MaxDiscount/MinSubtotal
    private decimal Fee => fulfillment == "Delivery" ? Shop.CurrentBranch.DeliveryFee : 0;
    private decimal Total => Shop.CartSubtotal - Discount + Fee;

    protected override async Task OnInitializedAsync()
    {
        // [APP-15] Vào giỏ khi chưa chọn hình thức nhận → hỏi ở trang /order-type, không tự gán "Nhận tại quầy".
        if (Shop.PreferredFulfillment is null && Shop.CartCount > 0) { Nav.NavigateTo("/order-type?next=/cart", replace: true); return; }
        try { vouchers = (await Crm.GetWalletAsync()).Where(v => v.Status == "Available").ToList(); }
        catch (ApiException) { }
        // [APP-01] Voucher đã chọn trước đó không còn trong ví (đã dùng/hết hạn) → bỏ chọn.
        if (Shop.SelectedVoucher is { } sv && vouchers.All(v => v.CustomerPromotionId != sv.CustomerPromotionId)) Shop.SelectedVoucher = null;
        try
        {
            await Shop.GetMenuAsync(); // để có thông tin cửa hàng (phí giao, hình thức nhận)
            var p = Crm.CachedProfile ?? await Crm.GetProfileAsync();
            contactName = p.FullName; contactPhone = p.Phone;
        }
        catch (ApiException) { }
        // [APP-05] Tải sổ địa chỉ, điền sẵn địa chỉ mặc định (hoặc địa chỉ mới nhất).
        try { addresses = await Crm.GetAddressesAsync(); } catch (ApiException) { }
        if ((addresses.FirstOrDefault(a => a.IsDefault) ?? addresses.FirstOrDefault()) is { } def) UseAddress(def);
        // [BUG-17] Mở giỏ với hình thức khách đã chọn ở trang chủ ("Giao hàng" / "Nhận tại quán"); nếu cửa hàng
        // không hỗ trợ hình thức đó thì dùng hình thức còn lại. Trước đây luôn mặc định "Nhận tại quầy".
        fulfillment = Shop.PreferredFulfillment ?? "Pickup"; // [APP-15] chỉ còn rơi vào "Pickup" khi giỏ trống (chưa đặt được gì)
        if (fulfillment == "Delivery" && !Shop.CurrentBranch.DeliveryEnabled) fulfillment = "Pickup";
        if (fulfillment == "Pickup" && !Shop.CurrentBranch.PickupEnabled && Shop.CurrentBranch.DeliveryEnabled) fulfillment = "Delivery";
    }

    private void PickVoucher(ChangeEventArgs e)
    {
        var id = int.TryParse(e.Value?.ToString(), out var x) ? x : (int?)null;
        // [APP-01] Chỉ lưu voucher đã chọn; số tiền giảm do Shop.VoucherDiscount tính lại theo giỏ.
        Shop.SelectedVoucher = vouchers.FirstOrDefault(item => item.CustomerPromotionId == id);
    }

    // [APP-05] Điền người nhận / SĐT / địa chỉ / ghi chú từ địa chỉ đã lưu.
    private void UseAddress(CustomerAddress a)
    {
        addressId = a.AddressId; contactName = a.RecipientName; contactPhone = a.Phone; address = a.AddressText; deliveryNote = a.Note;
    }

    private void PickAddress(ChangeEventArgs e) // [APP-05]
    {
        var id = int.TryParse(e.Value?.ToString(), out var x) ? x : (int?)null;
        if (addresses.FirstOrDefault(a => a.AddressId == id) is { } a) { UseAddress(a); return; }
        addressId = null; address = null; deliveryNote = null; // "+ Nhập địa chỉ mới": giữ tên, SĐT; xóa địa chỉ
        contactName = Crm.CachedProfile?.FullName ?? contactName; contactPhone = Crm.CachedProfile?.Phone ?? contactPhone;
    }

    private async Task Place()
    {
        // [APP-01] Chặn trước khi gửi: máy chủ từ chối đơn chưa đủ giá trị tối thiểu của voucher.
        if (Shop.VoucherBelowMinimum) { Toasts.Show($"Đơn chưa đủ {Fmt.Money(Shop.SelectedVoucher!.MinSubtotal)} để dùng voucher. Thêm món hoặc bỏ voucher.", true); return; }
        if (fulfillment == "Delivery")
        {
            if (string.IsNullOrWhiteSpace(contactName) || string.IsNullOrWhiteSpace(address)) { Toasts.Show("Vui lòng nhập người nhận và địa chỉ giao.", true); return; }
            if (string.IsNullOrWhiteSpace(contactPhone) || !PhoneRule.IsValid(contactPhone)) { Toasts.Show(PhoneRule.Message, true); return; }
        }
        busy = true;
        try
        {
            var info = new Checkout(fulfillment, paymentMode,
                fulfillment == "Delivery" ? contactName : null, fulfillment == "Delivery" ? contactPhone : null,
                fulfillment == "Delivery" ? address : null, fulfillment == "Delivery" ? deliveryNote : null,
                string.IsNullOrWhiteSpace(note) ? null : note.Trim());
            var saveNew = fulfillment == "Delivery" && saveAddress && IsNewAddress; // [APP-05] xét trước khi giỏ bị xóa
            var order = await Shop.PlaceOrderAsync(info, requestKey);
            requestKey = Guid.NewGuid();
            // [APP-05] Lưu địa chỉ mới làm mặc định cho lần sau; lỗi lưu địa chỉ không ảnh hưởng đơn vừa đặt.
            if (saveNew)
                try { await Crm.SaveAddressAsync(addresses.Count == 0 ? "Nhà" : $"Địa chỉ {addresses.Count + 1}", contactName!, contactPhone!, address!, deliveryNote, true); }
                catch (ApiException) { }
            Toasts.Show(order.PaymentMode == "Prepaid" ? "Đã tạo đơn. Vui lòng thanh toán trong 15 phút." : "Đặt hàng thành công!");
            Nav.NavigateTo($"/orders/{order.OrderId}", replace: true);
        }
        catch (ApiException e) { Toasts.Error(e); }
        busy = false;
    }
}
