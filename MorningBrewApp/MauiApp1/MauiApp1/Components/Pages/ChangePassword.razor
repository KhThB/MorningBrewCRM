@page "/account/password"
@* [BUG-05] Khách tự đổi mật khẩu (trước đây không có chức năng này). *@
@inject AuthService Auth
@inject ToastService Toasts
@inject NavigationManager Nav

<PageHeader Title="Đổi mật khẩu" BackTo="/account" />

<div class="page-body with-footer">
    <form id="password-form" class="card form" @onsubmit="Save" @onsubmit:preventDefault>
        <label for="current">Mật khẩu hiện tại *</label>
        <input id="current" class="input" type="password" @bind="current" autocomplete="current-password" required />

        <label for="next">Mật khẩu mới * <small class="muted">(ít nhất 10 ký tự)</small></label>
        <input id="next" class="input" type="password" @bind="next" @bind:event="oninput" minlength="10" autocomplete="new-password" required />

        <label for="confirm">Nhập lại mật khẩu mới *</label>
        <input id="confirm" class="input" type="password" @bind="confirm" autocomplete="new-password" required />
        <small class="muted">Sau khi đổi, các thiết bị khác đang đăng nhập tài khoản này sẽ bị đăng xuất.</small>
    </form>
</div>

<div class="footer-bar">
    <button class="btn btn-primary block" type="submit" form="password-form" disabled="@busy">@(busy ? "Đang lưu..." : "Đổi mật khẩu")</button>
</div>

@code {
    private string current = "", next = "", confirm = "";
    private bool busy;

    private async Task Save()
    {
        if (next.Length < 10) { Toasts.Show("Mật khẩu mới cần ít nhất 10 ký tự.", true); return; }
        if (next != confirm) { Toasts.Show("Mật khẩu nhập lại không khớp.", true); return; }
        if (next == current) { Toasts.Show("Mật khẩu mới phải khác mật khẩu hiện tại.", true); return; }
        busy = true;
        try
        {
            await Auth.ChangePasswordAsync(current, next);
            Toasts.Show("Đã đổi mật khẩu.");
            Nav.NavigateTo("/account", replace: true);
        }
        catch (ApiException e) { Toasts.Error(e); }
        busy = false;
    }
}
